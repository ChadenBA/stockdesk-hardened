# StockDesk settings - EXAMPLE VALUES ONLY, for local development.
# Copy to .env (ignored by git) and set your own local values.
# Real values never go in the repository: in the cluster they live in the
# Kubernetes Secret "stockdesk-env", created by an admin (see README).
NODE_ENV=production
PORT=3000
DB_HOST=db
DB_PORT=5432
DB_USER=stockdesk
DB_PASSWORD=change-me-local-only
API_KEY=change-me-local-only
